modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 19171
externalPort = 80

[userenv]

[userenv.shared]
SMTP_USER = "zealcare24@gmail.com"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
NOTIFY_EMAIL = "zealcare24@gmail.com"
